<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= categoryDetails.category_name %> Projects</h2>

    <ul>
        <% projects.forEach(project => { %>
            <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
        <% }) %>
    </ul>

    <% if (user && user.role_name==='admin' ) { %>
        <p class="actions-container"><a href="/edit-category/<%= categoryDetails.category_id %>" class="btn-action">Edit Category</a></p>
    <% } %>
</main>
<%- include('partials/footer') %>