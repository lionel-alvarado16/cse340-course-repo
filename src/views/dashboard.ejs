<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

    <% if (user && user.role_name === 'admin') { %>
        <p class="actions-container"><a href="/users" class="btn-action">Registered Users</a></p>
    <% } %>

    <section class="volunteer-projects-section">
        <h3>My Volunteer Projects</h3>

        <% if (volunteerProjects && volunteerProjects.length > 0) { %>
            <ul class="volunteer-list">
                <% volunteerProjects.forEach(project => { %>
                    <li class="volunteer-item">
                        <div>
                            <p><strong><a href="/project/<%= project.project_id %>"><%= project.title %></a></strong></p>
                            <p>Location: <%= project.location %></p>
                            <p>Date: <%= new Date(project.date).toLocaleDateString() %></p>
                        </div>
                        <p class="actions-container">
                            <a href="/dashboard/project/<%= project.project_id %>/remove-volunteer" class="btn-action btn-danger">Remove Volunteer</a>
                        </p>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>You have not signed up to volunteer for any projects yet.</p>
        <% } %>
    </section>

</main>

<%- include('partials/footer') %>