<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    
    <h2><%= categoryDetails.category_name %></h2> 
    <form action="/edit-category/<%= categoryDetails.category_id %>" method="POST">
        <div class="form-group">
            <label for="name">Category Name</label>
            <input
                type="text"
                id="name"
                name="categoryName"
                value="<%= categoryDetails.category_name %>"
                maxlength="100"
                required
            />
        </div>

        <button type="submit">Update Category</button>
    </form>

</main>
<%- include('partials/footer') %>