<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= projectDetails.title %></h2>    
    <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                id="name"
                name="title"
                value="<%= projectDetails.title %>"
                maxlength="150"
                required
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                maxlength="500"
                required
            ><%= projectDetails.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                maxlength="255"
                required
                value="<%= projectDetails.location %>"
            />
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <input
                type="date"
                id="date"
                name="date"
                required
                value="<%= new Date(projectDetails.date).toLocaleDateString() %>"
            />
        </div>

        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select
                id="organizationId"
                name="organizationId"
                required
            >
                <option value="<%= projectDetails.organization_name %>">Select an organization</option>
                <% organizations.forEach(org => { %>
                    <option value="<%= org.organization_id %>"><%= org.name %></option>
                <% }); %>
            </select>
        </div>

        <button type="submit">Update Service Project</button>
    </form>

</main>
<%- include('partials/footer') %>