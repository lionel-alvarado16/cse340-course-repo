<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    
    <form action="/new-category" method="POST">
        <div class="form-group">
            <label for="title">Category Name</label>
            <input
                type="text"
                id="name"
                name="categoryName"
                maxlength="100"
                required
            />
        </div>

        <button type="submit">Create Category</button>
    </form>

</main>
<%- include('partials/footer') %>