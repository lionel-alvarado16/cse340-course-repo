<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    
    <p>Here are a few of our partner organizations:</p>
    <ul>
        <% organizations.forEach(organization => { %>
            <li><img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo"><a href="/organization/<%= organization.organization_id %>"><strong><%= organization.name %></strong></a>: <%= organization.contact_email %></li>
        <% }); %>
    </ul>

    <% if (user && user.role_name==='admin' ) { %>
        <p class="actions-container"><a href="/new-organization" class="btn-action btn-secondary">Add a new organization</a></p>
    <% } %>
</main>
<%- include('partials/footer') %>