<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/images/favicon-icon.png">
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <nav>
        <div class="nav-container">
            <a href="/" class="nav-brand">
                <img src="/images/favicon-icon.png" alt="CSE 340 Service Network Icon" class="nav-logo">
                <span class="nav-title">Service Network</span>
            </a>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/organizations">Organizations</a></li>
                <li><a href="/projects">Projects</a></li>
                <li><a href="/categories">Categories</a></li>
                <% if (isLoggedIn) { %>
                    <li><a href="/logout">Logout</a></li>
                <% } else { %>
                    <li><a href="/register">Register</a></li>
                    <li><a href="/login">Login</a></li>
                <% } %>
            </ul>
        </div>
    </nav>

    <% const messages = flash(); %>
    <% Object.keys(messages).forEach(type => { %>
        <% if (messages[type].length > 0) { %>
            <% messages[type].forEach(msg => { %>
                <div class="alert <%= type %>">
                    <%= msg %>
                </div>
            <% }); %>
        <% } %>
    <% }); %>