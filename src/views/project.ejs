<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= projectDetails.title %></h2>

    <p>Description: <%= projectDetails.description %></p>
    <p>Date: <%= new Date(projectDetails.date).toLocaleDateString() %></p>
    <p>Location: <%= projectDetails.location %></p>
    <p>Partner Organization Name: <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>

    <div class="project-categories">
        <p>Categories:</p>
        <div class="tags-container">
            <% categories.forEach(category => { %>
                <a href="/category/<%= category.category_id %>" class="category-tag"><%= category.category_name %></a>
            <% }) %>
        </div>
    </div>

    <!-- Admin Management Actions Group -->
    <% if (user && user.role_name === 'admin') { %>
        <div class="admin-actions-group">
            <a href="/edit-project/<%= projectDetails.project_id %>" class="btn-action btn-secondary">Edit Service Project</a>
            <a href="/assign-categories/<%= projectDetails.project_id %>" class="btn-action btn-secondary">Edit Categories</a>
        </div>
    <% } %>

    <!-- User Volunteer Action / Status -->
    <% if (user) { %>
        <% if (isVolunteer) { %>
            <div class="volunteer-status-card active">
                <span class="status-message">✓ You are volunteering for this project.</span>
                <a href="/project/<%= projectDetails.project_id %>/remove-volunteer" class="btn-action btn-danger">Remove Volunteer</a>
            </div>
        <% } else { %>
            <div class="actions-container">
                <a href="/project/<%= projectDetails.project_id %>/volunteer" class="btn-action">Volunteer for this project</a>
            </div>
        <% } %>
    <% } %>
</main>
<%- include('partials/footer') %>