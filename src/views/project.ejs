<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= projectDetails.title %></h2>

    <p>Description: <%= projectDetails.description %></p>
    <p>Date: <%= new Date(projectDetails.date).toLocaleDateString() %></p>
    <p>Location: <%= projectDetails.location %></p>
    <p>Partner Organization Name: <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>

    <div class="project-categories">
        <p>Categories:</p>
        <div class="tags-container">
            <% categories.forEach(category => { %>
                <a href="/category/<%= category.category_id %>" class="category-tag"><%= category.category_name %></a>
            <% }) %>
        </div>
    </div>

    <% if (user && user.role_name==='admin' ) { %>
        <p class="actions-container"><a href="/edit-project/<%= projectDetails.project_id %>" class="btn-action">Edit Service Project</a></p>
        <p class="actions-container"><a href="/assign-categories/<%= projectDetails.project_id %>" class="btn-action">Edit Categories</a></p>
    <% } %>

    <% if (user) { %>
        <% if (isVolunteer) { %>
            <p class="actions-container">
                You are volunteering for this project. 
                <a href="/project/<%= projectDetails.project_id %>/remove-volunteer" class="btn-action">Remove Volunteer</a>
            </p>
        <% } else { %>
            <p class="actions-container">
                <a href="/project/<%= projectDetails.project_id %>/volunteer" class="btn-action">Volunteer for this project</a>
            </p>
        <% } %>
    <% } %>
</main>
<%- include('partials/footer') %>