<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <strong><%= new Date(project.date).toLocaleDateString() %></strong>:
                <%= project.title %>
                (<em><%= project.organization_name %></em>)
                <p><%= project.description %> - <strong>Location:</strong> <%= project.location %></p>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>